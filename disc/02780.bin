яф$яяю$яяхяяя$яя$яя$ъсъъ$т$$ют$цыъ$$ъ$$ы$$ю$$$ц$ъъ$$$$юцъ$юы$$$$цэ$$ю$юц$$цют$$$юцт$$я$ьяя
